  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": false, "skipLibCheck": true, "types": ["node"], "noEmit": true
  },
  "include": ["src"]
}
